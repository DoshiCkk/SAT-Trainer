# Cloudflare Pages reads this file from the deployed root.

# Vite puts a content hash in these names, so they can never go stale.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# A crop keeps its question's id as a name, so re-parsing can replace one.
/img/*
  Cache-Control: public, max-age=604800

# Must be re-checked, or a new build would never reach an installed app.
/sw.js
  Cache-Control: no-cache
/index.html
  Cache-Control: no-cache
/questions.json
  Cache-Control: no-cache

/*
  X-Robots-Tag: noindex, nofollow
  Referrer-Policy: no-referrer
